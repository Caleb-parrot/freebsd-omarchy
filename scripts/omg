#!/bin/sh
#
# omg — launch the desktop from a FreeBSD TTY.
#
# Dell Precision T1600: i915kms does not work, so the default session is
# Xorg + scfb + i3. Hyprland/Aquamarine needs DRM and cannot use scfb.
# OMG_HYPRLAND=1 forces the Wayland path when /dev/dri exists.
#
# Usage: log in on a virtual terminal and run `omg`.

# Seat access (FreeBSD uses seatd instead of systemd-logind).
export LIBSEAT_BACKEND=seatd

# Terminals (foot, ...) spawn $SHELL; make it the user's real login shell so
# they load Omarchy's bash config (aliases like `ls` -> eza, the prompt). A TTY
# session started before the login shell was changed carries a stale SHELL.
_login_shell="$(getent passwd "$(id -un)" 2>/dev/null | awk -F: '{print $NF}')"
[ -x "$_login_shell" ] && export SHELL="$_login_shell"
unset _login_shell

# Wayland / XDG session identity.
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland

# Omarchy's Lua config (hyprland.lua) and its bin/ helpers live in the cloned
# source tree; hyprland.lua reads OMARCHY_PATH to find default/hypr/bootstrap.lua.
export OMARCHY_PATH="${OMARCHY_PATH:-$HOME/.local/src/omarchy}"

# Put Omarchy's helper scripts and the uwsm-app shim on PATH.
PATH="$OMARCHY_PATH/bin:$HOME/.local/bin:$PATH"
export PATH

# FreeBSD has no systemd-logind to create XDG_RUNTIME_DIR. Prefer an existing
# one (pam_xdg uses /var/run/xdg/$USER; consolekit2 uses /var/run/user/UID).
# Hyprland's constructor only treats /run/user as "standard", so the warning
# on FreeBSD is expected. Fall back to /tmp if nothing exists yet.
if [ -z "$XDG_RUNTIME_DIR" ]; then
	if [ -d "/var/run/xdg/$(id -un)" ]; then
		XDG_RUNTIME_DIR="/var/run/xdg/$(id -un)"
	elif [ -d "/var/run/user/$(id -u)" ]; then
		XDG_RUNTIME_DIR="/var/run/user/$(id -u)"
	else
		XDG_RUNTIME_DIR="/tmp/runtime-$(id -u)"
	fi
	export XDG_RUNTIME_DIR
fi
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# Crash reporter does mkdir() (not mkdir -p) of $HOME/.cache/hyprland; a
# missing ~/.cache makes the real std::runtime_error message disappear.
CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
mkdir -p "$CACHE_HOME/hyprland"

if ! id -Gn | grep -qw video; then
	printf 'error: %s is not in the video group in this session.\n' "$(id -un)" >&2
	printf '       doas pw groupmod video -m %s\n' "$(id -un)" >&2
	printf '       then log out and back in before running omg.\n' >&2
	exit 1
fi

# T1600: i915kms does not work. Hyprland/Aquamarine needs DRM (/dev/dri) and
# cannot use scfb. Default session is Xorg + scfb + i3. Set OMG_HYPRLAND=1 to
# force the Wayland path if a KMS device appears later.
if [ -z "$OMG_HYPRLAND" ]; then
	if kldstat -q -n i915kms 2>/dev/null; then
		printf 'warning: i915kms is still loaded; scfb needs the vt framebuffer.\n' >&2
		printf '         reboot (do not kldunload i915kms — it freezes the TTY).\n' >&2
	fi
	if ! command -v startx >/dev/null 2>&1; then
		printf 'error: startx not found. Re-run: sh bootstrap/prepare-system.sh\n' >&2
		exit 1
	fi
	XINITRC="$HOME/.xinitrc"
	if [ ! -f "$XINITRC" ]; then
		printf '==> writing %s (i3 on Xorg/scfb)\n' "$XINITRC"
		cat > "$XINITRC" <<'EOF'
#!/bin/sh
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=i3
exec i3
EOF
	fi
	export XDG_SESSION_TYPE=x11
	export XDG_CURRENT_DESKTOP=i3
	printf '==> T1600 scfb session (Xorg + i3). Hyprland needs i915kms and cannot run.\n'
	if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
		exec dbus-run-session startx
	fi
	exec startx
fi

# Qt / QuickShell (the Omarchy top bar) on Wayland.
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland

if [ ! -e /dev/dri/card0 ]; then
	printf 'error: OMG_HYPRLAND=1 but no /dev/dri/card0.\n' >&2
	exit 1
fi
if ! sockstat -l 2>/dev/null | grep -q seatd; then
	if ! service seatd onestatus >/dev/null 2>&1; then
		printf 'error: seatd is not running. doas service seatd start\n' >&2
		exit 1
	fi
fi

dump_hypr_log() {
	inst=$(ls -td "$XDG_RUNTIME_DIR"/hypr/* 2>/dev/null | head -1)
	[ -n "$inst" ] && [ -f "$inst/hyprland.log" ] || return 0
	cp "$inst/hyprland.log" "$CACHE_HOME/hyprland/last.log" 2>/dev/null || true
	printf '\nHyprland failed. Last log (%s):\n' "$inst/hyprland.log" >&2
	tail -n 80 "$inst/hyprland.log" >&2
}

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ] && command -v dbus-run-session >/dev/null 2>&1; then
	dbus-run-session -- Hyprland || { dump_hypr_log; exit 1; }
	exit 0
fi
Hyprland || { dump_hypr_log; exit 1; }
